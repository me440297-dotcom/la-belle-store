generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. جدول المستخدمين (للأدمن والعملاء)
model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  password  String?
  role      Role      @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  sessions  Session[]
}

enum Role {
  ADMIN
  CUSTOMER
}

// 2. جدول الأقسام (Tops, Dresses, etc.)
model Category {
  id          String    @id @default(cuid())
  name        String
  nameAr      String?
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 3. جدول المنتجات
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  oldPrice    Float?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  images      Image[]
  variants    Variant[]
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reviews     Review[]
  orderItems  OrderItem[] // ربط المنتج بالطلبات
}

// 4. جدول الصور
model Image {
  id        String  @id @default(cuid())
  url       String
  color     String? // لو الصورة مربوطة بلون معين (لو فاضي تظهر مع كل الألوان)
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 5. جدول الألوان والمقاسات (Variants)
model Variant {
  id        String  @id @default(cuid())
  color     String
  colorHex  String?
  size      String
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// 6. جدول الطلبات (الرئيسي)
model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  address      String?
  total        Float
  status       OrderStatus @default(PENDING) // استخدمنا الـ enum بدل الـ String
  userId       String? // لو العميل مسجل دخول
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[] // العلاقة الصح مع منتجات الطلب
  createdAt    DateTime    @default(now())
}

// 7. تفاصيل الطلب (المنتجات اللي جوه الطلب)
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // ربط المنتج
  quantity  Int
  price     Float
  name      String? // اسم المنتج وقت الطلب (لو اتمسح المنتج بعدين يفضل ظاهر)
  size      String?
  color     String?
}

// 8. جداول NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 9. جدول إعدادات الموقع
model SiteSettings {
  id             String  @id @default(cuid())
  whatsappNumber String  @default("201227840123")
  facebookUrl    String?
  instagramUrl   String?
  contactEmail   String?
  heroTitle      String  @default("Layered Style")
  heroSubtitle   String  @default("Effortless Elegance")
  heroImage      String?
  heroTag        String  @default("New Collection")
  heroDescription String @default("Sweater + Shirt = Perfect Look")
  heroButtonText String  @default("Shop Now")
  topBarText     String  @default("New Products Every Day!")
  welcomeTitle   String  @default("Discover a world of elegance and beauty")
  welcomeSubtitle String @default("The latest fashion trends")
  welcomeButtonText String @default("Explore Now")
  welcomeImage   String?
  sizeChart      String? // جدول المقاسات (نص: كل سطر صف، القيم بفاصلة)
}

// 10. جدول تقييمات المنتجات
model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}
